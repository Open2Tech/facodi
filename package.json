{
  "name": "facodi",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-facodi-media.mjs && node scripts/validate-facodi-email-templates.mjs && node scripts/validate-facodi-project-pages.mjs && vite build && bun scripts/generate-seo-snapshots.mjs && bun scripts/write-workers-build-revision.mjs",
    "build:dev": "vite build --mode development",
    "build:analyze": "vite build && open dist/stats.html || start dist/stats.html",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "db:types": "supabase gen types typescript --project-id wvkjainfwsyiyfcmbtid --schema facodi",
    "test": "vitest run && node --check scripts/enrichment/youtube-playlist-items-sync.mjs && node --test scripts/enrichment/youtube-data-api-utils.test.mjs scripts/enrichment/youtube-playlist-items.node-tests.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "test:email": "bun scripts/generate-facodi-email-templates.ts --check && node scripts/validate-facodi-email-templates.mjs && vitest run --config vitest.email.config.ts",
    "test:project": "node scripts/validate-facodi-project-pages.mjs",
    "test:workers:smoke": "node scripts/smoke-facodi-workers.mjs",
    "test:media": "node scripts/validate-facodi-media.mjs",
    "email:generate": "bun scripts/generate-facodi-email-templates.ts"
  },
