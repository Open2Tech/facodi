<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="open2_layout" model="theme.ir.ui.view">
        <field name="name">Open2 global layout</field>
        <field name="key">theme_open2.open2_layout</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="arch" type="xml">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="open2-site" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div class="open2-loader" data-open2-loader="1" aria-hidden="true">
                <div class="open2-loader__mark">
                    <img src="/theme_open2/static/src/img/branding/splash/open2-splash-logo.svg" alt="" width="260" height="130"/>
                    <span>Open minds. Open source. Open future.</span>
                </div>
            </div>
        </xpath>
        <xpath expr="//head" position="inside">
            <link rel="icon" type="image/svg+xml" href="/theme_open2/static/src/img/branding/favicons/favicon.svg"/>
            <link rel="icon" type="image/x-icon" href="/theme_open2/static/src/img/branding/favicons/favicon.ico"/>
            <link rel="apple-touch-icon" href="/theme_open2/static/src/img/branding/favicons/apple-touch-icon.png"/>
            <meta name="theme-color" content="#0D1117"/>
            <meta property="og:image" content="/theme_open2/static/src/img/branding/social/open2-og.png"/>
            <meta name="twitter:card" content="summary_large_image"/>
            <meta name="twitter:image" content="/theme_open2/static/src/img/branding/social/open2-twitter-card.png"/>
            <script t-if="main_object and 'url' in main_object and main_object.url == '/'" type="application/ld+json">
                {"@context":"https://schema.org","@type":"Organization","name":"Open2 Technology","url":"<t t-out="request.httprequest.host_url.rstrip('/')"/>","logo":"<t t-out="request.httprequest.host_url.rstrip('/') + '/theme_open2/static/src/img/branding/logos/open2-logo-horizontal.svg'"/>","sameAs":["https://github.com/Open2Tech"]}
            </script>
            <script t-if="main_object and 'url' in main_object and main_object.url == '/partnerships'" type="application/ld+json">
                {"@context":"https://schema.org","@type":"ItemList","name":"Open2 Technology partnerships","itemListElement":[{"@type":"ListItem","position":1,"name":"University of Algarve"},{"@type":"ListItem","position":2,"name":"SEA-EU"},{"@type":"ListItem","position":3,"name":"Corvanis"},{"@type":"ListItem","position":4,"name":"Jus Nacionalidade"}]}
            </script>
        </xpath>
        <xpath expr="//t[@t-set='meta_description']" position="after">
            <t t-if="main_object and 'url' in main_object and main_object.url == '/'" t-set="meta_description" t-value="'Open2 builds accessible and inclusive technology for people, teams, and organizations.'"/>
        </xpath>
        <xpath expr="//t[@t-set='default_title']" position="after">
            <t t-if="main_object and 'url' in main_object and main_object.url == '/'" t-set="default_title" t-value="'Open2 Technology — Building open solutions for a better tomorrow'"/>
        </xpath>
        </field>
    </record>
</odoo>
