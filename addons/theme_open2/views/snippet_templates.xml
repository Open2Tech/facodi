    <record id="s_open2_text_image" model="theme.ir.ui.view"><field name="name">Open2 Text and Image</field><field name="key">theme_open2.s_open2_text_image</field><field name="type">qweb</field><field name="arch" type="xml">
        <section class="s_open2_text_image open2-section" data-snippet="s_open2_text_image" data-name="Open2 Text and Image">
