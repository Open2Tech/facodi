<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="s_open2_hero" model="theme.ir.ui.view"><field name="name">Open2 Hero</field><field name="key">theme_open2.s_open2_hero</field><field name="type">qweb</field><field name="arch" type="xml">
        <section class="s_open2_hero open2-section" data-snippet="s_open2_hero" data-name="Open2 Hero">
            <div class="open2-container">
                <p class="open2-label">Inclusive technology</p>
                <h1>Democratizing <span class="open2-accent-violet">access to</span> <span class="open2-outline">technology</span></h1>
                <div class="open2-hero__footer">
                    <p>We build digital products that break barriers, making technology accessible, inclusive, and truly useful for everyone.</p>
                    <div class="open2-actions">
                        <a class="btn open2-button open2-button--light" href="/contact">Start a project</a>
                        <a class="btn open2-button open2-button--outline" href="/partnerships">Partnerships</a>
                    </div>
                </div>
            </div>
        </section>
    </field></record>

    <record id="s_open2_intro" model="theme.ir.ui.view"><field name="name">Open2 Introduction</field><field name="key">theme_open2.s_open2_intro</field><field name="type">qweb</field><field name="arch" type="xml">
        <section class="s_open2_intro open2-section open2-section--compact" data-snippet="s_open2_intro" data-name="Open2 Introduction">
            <div class="open2-container open2-split">
                <h2>Technology should make participation possible.</h2>
                <div class="open2-prose">
                    <p>Open2 brings engineering, accessibility, and practical collaboration together. We design systems around the people who rely on them.</p>
                    <a class="open2-text-link" href="/solutions">Explore our solutions <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                </div>
            </div>
        </section>
    </field></record>

    <record id="s_open2_services" model="theme.ir.ui.view"><field name="name">Open2 Services</field><field name="key">theme_open2.s_open2_services</field><field name="type">qweb</field><field name="arch" type="xml">
        <section class="s_open2_services open2-section" data-snippet="s_open2_services" data-name="Open2 Services">
            <div class="open2-service open2-service--dark">
                <div class="open2-container open2-service__grid">
                    <div class="open2-service__signal" aria-hidden="true">O2</div>
                    <div>
                        <p class="open2-stack-words"><span>Accessibility.</span><span>Inclusion.</span><strong>Impact.</strong></p>
                        <h2><span class="open2-accent-blue">Odoo</span> expertise</h2>
                        <p class="open2-lead">We shape Odoo around real people and real operations, turning daily work into clear, accessible flows that help teams move with confidence.</p>
                        <ul class="open2-tags" aria-label="Odoo capabilities">
                            <li>ERP Architecture</li><li>Custom Flows</li><li>API Sync</li><li>Live Dashboards</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="open2-service open2-service--teal">
                <div class="open2-container open2-service__grid">
                    <div class="open2-service__signal" aria-hidden="true">&lt;/&gt;</div>
                    <div>
                        <p class="open2-label open2-label--ink">Inclusive by design</p>
                        <h2>Accessible software</h2>
                        <div class="open2-split open2-split--tight">
                            <p class="open2-lead">We build around your context, your people, and your goals, so technology feels simple to use and valuable from day one.</p>
                            <ul class="open2-feature-list">
                                <li><strong>Internal tools</strong><span>Made for everyday usability.</span></li>
                                <li><strong>Platforms</strong><span>Built for inclusive digital access.</span></li>
                            </ul>
                        </div>
                        <a class="open2-arrow-link" href="/partnerships"><span aria-hidden="true">→</span> View partnerships</a>
                    </div>
                </div>
            </div>
        </section>
    </field></record>

    <record id="s_open2_ai" model="theme.ir.ui.view"><field name="name">Open2 AI</field><field name="key">theme_open2.s_open2_ai</field><field name="type">qweb</field><field name="arch" type="xml">
        <section class="s_open2_ai open2-section" data-snippet="s_open2_ai" data-name="Open2 AI">
            <div class="open2-container">
                <div class="open2-ai__heading">
                    <span aria-hidden="true">AI</span>
                    <h2>AI for <em>everyone</em></h2>
                </div>
                <p class="open2-lead open2-measure">Beyond buzzwords, we use AI to remove friction, support better decisions, and make digital experiences clearer, faster, and easier for everyone.</p>
                <div class="open2-ai__list">
                    <article><h3>Clarity</h3><p>Knowledge systems that make information easy to find, understand, and act on.</p></article>
                    <article><h3>Flow</h3><p>Helpful automations that remove repetitive work and keep teams focused on what matters.</p></article>
                    <article><h3>Inclusion</h3><p>Transparent, responsible solutions designed to serve real people in real contexts.</p></article>
                </div>
            </div>
        </section>
    </field></record>

