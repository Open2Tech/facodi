    <record id="s_open2_cta" model="theme.ir.ui.view"><field name="name">Open2 Call to Action</field><field name="key">theme_open2.s_open2_cta</field><field name="type">qweb</field><field name="arch" type="xml">
        <section class="s_open2_cta open2-section" data-snippet="s_open2_cta" data-name="Open2 Call to Action">
            <div class="open2-container open2-cta__grid">
                <h2>Ready to <span>open access?</span></h2>
                <div><p>Let's build something people can actually use. No pressure, just a conversation about the barriers you want to remove.</p><a class="btn open2-button open2-button--ink" href="/contact">Let's build access</a></div>
