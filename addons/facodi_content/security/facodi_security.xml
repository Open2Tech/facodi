<odoo>
    <record id="res_groups_privilege_facodi" model="res.groups.privilege">
        <field name="name">FACODI</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_facodi_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_facodi"/>
    </record>

