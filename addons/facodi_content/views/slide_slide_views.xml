<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form" model="ir.ui.view">
        <field name="name">facodi.slide.slide.form</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="facodi_enrichment" string="Enrichment">
                    <group>
                        <group>
                            <field name="enrichment_state"/>
                            <field name="facodi_source_key"/>
                            <field name="enrichment_job_ref"/>
                            <field name="enrichment_updated_at"/>
                        </group>
                        <group>
                            <field name="enrichment_error" invisible="enrichment_state != 'failed'"/>
                        </group>
                    </group>
                    <field name="enrichment_summary" widget="html" placeholder="Suggested summary from the enrichment service..."/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>