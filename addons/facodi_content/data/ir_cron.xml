<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_refresh_enrichment" model="ir.cron">
        <field name="name">FACODI: Refresh enrichment jobs</field>
        <field name="model_id" ref="website_slides.model_slide_slide"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_enrichment()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_run_facodi_jobs" model="ir.cron">
        <field name="name">FACODI: Run background jobs</field>
        <field name="model_id" ref="model_facodi_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_pending_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_schedule_facodi_refresh" model="ir.cron">
        <field name="name">FACODI: Schedule resource refresh</field>
        <field name="model_id" ref="model_facodi_resource"/>
        <field name="state">code</field>
        <field name="code">model._cron_queue_due_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
