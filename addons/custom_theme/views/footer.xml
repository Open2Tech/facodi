<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="facodi_footer" inherit_id="website.layout" name="FACODI footer">
        <xpath expr="//footer" position="replace">
            <footer id="bottom" class="facodi-footer" data-name="FACODI Footer">
                <div class="container-fluid facodi-footer-inner">
                    <div>
                        <a href="/" class="facodi-wordmark">FACODI<span>.</span></a>
                        <p>Faculdade Comunitaria Digital. Educacao superior aberta, colaborativa e acessivel.</p>
                    </div>
                    <div class="facodi-footer-links">
                        <a href="/slides">Cursos</a>
                        <a href="/website/search">Recursos abertos</a>
                        <a href="/contactus">Contato</a>
                        <a href="/web/login">Minha conta</a>
                    </div>
                    <p class="facodi-footer-meta">Open source para aprender em publico.<br/><span t-esc="datetime.datetime.now().year"/> FACODI</p>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>