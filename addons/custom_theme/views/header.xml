<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="facodi_header" inherit_id="website.layout" name="FACODI header">
        <xpath expr="//header" position="replace">
            <header id="top" data-name="FACODI Header" class="o_header_standard facodi-header">
                <nav aria-label="Primary navigation" class="navbar navbar-expand-lg">
                    <div id="o_main_nav" class="container-fluid facodi-nav-shell">
                        <a href="/" class="navbar-brand facodi-wordmark" aria-label="FACODI home">FACODI<span>.</span></a>
                        <button class="navbar-toggler facodi-icon-button" type="button" data-bs-toggle="collapse" data-bs-target="#top_menu_collapse" aria-controls="top_menu_collapse" aria-expanded="false" aria-label="Open navigation">
                            <i class="fa fa-bars" aria-hidden="true"/>
                        </button>
                        <div id="top_menu_collapse" class="collapse navbar-collapse">
                            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                                <li class="nav-item"><a class="nav-link" href="/slides">Cursos</a></li>
                                <li class="nav-item"><a class="nav-link" href="/slides/all">Explorar</a></li>
                                <li class="nav-item"><a class="nav-link" href="/website/search">Comunidade</a></li>
                                <li class="nav-item"><a class="nav-link" href="/contactus">Sobre</a></li>
                                <li class="nav-item ms-lg-2"><a class="btn facodi-button facodi-button-primary" href="/web/login">Entrar <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a></li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>
</odoo>