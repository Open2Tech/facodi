<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="facodi_header" inherit_id="website.layout" name="FACODI header">
        <xpath expr="//header" position="replace">
            <header id="top" data-name="FACODI Header" class="o_header_standard facodi-header">
                <nav aria-label="Primary navigation" class="navbar navbar-expand-lg">
                    <div id="o_main_nav" class="container-fluid facodi-nav-shell">
                        <a href="/" class="navbar-brand facodi-wordmark" aria-label="FACODI home">FACODI<span>.</span></a>
                        <button class="navbar-toggler facodi-icon-button" type="button" data-bs-toggle="collapse" data-bs-target="#top_menu_collapse" aria-controls="top_menu_collapse" aria-expanded="false" aria-label="Abrir navegação">
                            <i class="fa fa-bars" aria-hidden="true"/>
                        </button>
                        <div id="top_menu_collapse" class="collapse navbar-collapse">
                            <ul class="navbar-nav top_menu ms-auto align-items-lg-center gap-lg-1">
                                <!-- Dynamic backend menus: parent labels are links, toggles open nested items. -->
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <li t-if="submenu.is_visible and submenu.child_id" class="nav-item dropdown facodi-menu-item" role="presentation">
                                        <a t-att-href="submenu.page_id.url if submenu.page_id else submenu._clean_url()" class="nav-link facodi-menu-parent-link" role="menuitem" aria-haspopup="true">
                                            <span t-field="submenu.name"/>
                                        </a>
                                        <ul class="dropdown-menu facodi-dropdown-menu" role="menu">
                                            <t t-foreach="submenu.child_id" t-as="child">
                                                <li t-if="child.is_visible" role="presentation">
                                                    <a t-att-href="child._clean_url()" class="dropdown-item" role="menuitem">
                                                        <span t-field="child.name"/>
                                                    </a>
                                                </li>
                                            </t>
                                        </ul>
                                    </li>
                                    <li t-elif="submenu.is_visible" class="nav-item facodi-menu-item" role="presentation">
                                        <a t-att-href="submenu._clean_url()" class="nav-link" role="menuitem">
                                            <span t-field="submenu.name"/>
                                        </a>
                                    </li>
                                </t>
                                <!-- Sign-in / user dropdown -->
                                <li class="nav-item ms-lg-2">
                                    <t t-call="portal.placeholder_user_sign_in"
                                        _link_class.f="btn facodi-button facodi-button-primary"/>
                                    <t t-call="portal.user_dropdown"
                                        _item_class.f="nav-item dropdown"
                                        _link_class.f="btn facodi-button facodi-button-primary border-0"
                                        _dropdown_menu_class.f="dropdown-menu-end"/>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>
</odoo>