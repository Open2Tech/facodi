<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="runtime_refinement" inherit_id="website.layout" name="FACODI runtime visual refinement" priority="998">
        <xpath expr="//head" position="inside">
            <style type="text/css"><![CDATA[
:root { --facodi-primary:#6A4BFF; --facodi-secondary:#5DC7FF; --facodi-ink:#1F1E42; --facodi-heading:#111035; --facodi-muted:#5C5A78; --facodi-bg:#F8F7FF; --facodi-surface:#FFF; --facodi-line:#E4E2F2; --facodi-container:1180px; --facodi-radius-sm:10px; --facodi-radius-md:16px; --facodi-radius-lg:24px; --facodi-action:linear-gradient(120deg,#6A4BFF 0%,#5DC7FF 100%); }
html,body { color:var(--facodi-ink); font-family:"Jost","Inter","Segoe UI",system-ui,sans-serif; }
body { background:radial-gradient(circle at 0 -10%,rgba(106,75,255,.13),transparent 30rem),var(--facodi-bg); }
h1,h2,h3,h4,h5,h6 { color:var(--facodi-heading); font-weight:750; letter-spacing:0; text-wrap:balance; }
p { color:var(--facodi-muted); text-wrap:pretty; }
.facodi-header { background:rgba(248,247,255,.86)!important; border:0!important; padding:10px 0; position:sticky; top:0; z-index:1030; backdrop-filter:blur(14px); }
.facodi-nav-shell { max-width:var(--facodi-container); margin:0 auto; min-height:52px; padding:0 20px!important; }
.facodi-wordmark { color:var(--facodi-heading)!important; font-size:1.08rem; font-weight:800; letter-spacing:.04em; }.facodi-wordmark span{color:var(--facodi-primary)!important;}
.facodi-header .nav-link { border-radius:var(--facodi-radius-sm); color:var(--facodi-ink)!important; font-size:.93rem; font-weight:600; margin:0 2px; padding:.45rem .7rem!important; }
.facodi-header .nav-link:hover,.facodi-header .nav-link:focus-visible { background:#EEEBFF; color:var(--facodi-primary)!important; }
.facodi-dropdown-menu { background:#FFF!important; border:1px solid var(--facodi-line)!important; border-radius:var(--facodi-radius-md)!important; box-shadow:0 8px 24px rgba(31,30,66,.10)!important; }
.facodi-button,.btn-primary,.o_wslides_js_course_join_link.btn-primary,.o_wslides_done_button.btn-primary { border:0!important; border-radius:var(--facodi-radius-sm)!important; box-shadow:none!important; font-weight:700!important; min-height:42px; padding:.62rem 1rem; transition:transform 180ms ease,box-shadow 180ms ease; }
.facodi-button-primary,.btn-primary,.o_wslides_js_course_join_link.btn-primary,.o_wslides_done_button.btn-primary { background:var(--facodi-action)!important; color:#FFF!important; }
.facodi-button-secondary,.btn-outline-primary { background:#FFF!important; border:1px solid #D2CDEA!important; color:var(--facodi-ink)!important; }
.facodi-button:hover,.btn-primary:hover,.btn-outline-primary:hover { box-shadow:0 6px 14px rgba(74,52,177,.18)!important; transform:translateY(-1px); }
.facodi-hero,.facodi-dashboard,.facodi-open-section,.o_wslides_course_main,.o_wslides_lesson_main { max-width:var(--facodi-container); margin-left:auto; margin-right:auto; }
.facodi-hero { align-items:center; border:0!important; gap:clamp(28px,5vw,72px)!important; min-height:520px; padding:clamp(48px,7vw,88px) 32px!important; }
.facodi-kicker { color:var(--facodi-primary)!important; font-size:.78rem; font-weight:750; letter-spacing:.06em; margin-bottom:14px; text-transform:uppercase; }
.facodi-hero h1 { font-size:clamp(2.8rem,5.3vw,5.25rem)!important; line-height:.98; max-width:10ch; }.facodi-lead{font-size:1.14rem;line-height:1.55;max-width:57ch;}
.facodi-hero-board { background:linear-gradient(145deg,#26205A,#4439A2)!important; border:0!important; border-radius:var(--facodi-radius-lg)!important; box-shadow:0 18px 34px rgba(48,35,130,.22)!important; max-width:450px; padding:26px!important; transform:none!important; }.facodi-hero-board,.facodi-hero-board strong,.facodi-hero-board span{color:#FFF!important;}.facodi-hero-board .facodi-live-dot{color:#D4F2FF!important;}.facodi-board-top{align-items:center;display:flex!important;gap:12px;justify-content:space-between;}.facodi-board-path{display:none;}.facodi-board-cards{display:grid!important;gap:8px;}.facodi-board-cards>div{display:flex!important;flex-direction:column;gap:2px;padding:10px 12px;}.facodi-board-cards div{border-radius:var(--facodi-radius-sm)!important;}.facodi-board-cards .is-selected{background:rgba(93,199,255,.22)!important;}
.facodi-dashboard { gap:32px; grid-template-columns:180px minmax(0,1fr)!important; min-height:auto!important; padding:20px 32px 64px; }.facodi-side-nav{border:0!important;padding:8px 0!important;}.facodi-side-nav a{border-radius:var(--facodi-radius-sm);color:var(--facodi-muted);padding:9px 10px;}.facodi-side-nav a.is-active,.facodi-side-nav a:hover{background:#EEEAFE!important;color:var(--facodi-primary)!important;}.facodi-dashboard-main{padding:0!important;}.facodi-insights{display:none;}
.facodi-section-heading{margin-bottom:22px;}.facodi-section-heading h2{font-size:clamp(1.7rem,2.5vw,2.4rem);}.facodi-course-grid{display:grid;gap:14px;grid-template-columns:repeat(2,minmax(0,1fr));}
.facodi-course-card,.o_wslides_course_card { background:var(--facodi-surface)!important; border:1px solid var(--facodi-line)!important; border-radius:var(--facodi-radius-md)!important; box-shadow:none!important; transition:border-color 180ms ease,box-shadow 180ms ease,transform 180ms ease; }.facodi-course-card{grid-template-columns:76px 1fr;padding:14px;}.facodi-course-art{border-radius:12px;}.facodi-course-card:hover,.o_wslides_course_card:hover{border-color:rgba(106,75,255,.55)!important;box-shadow:0 7px 16px rgba(57,44,143,.12)!important;transform:translateY(-2px);}
.o_wslides_course_card{overflow:hidden;}.o_wslides_course_card .card-body{padding:18px;}.o_wslides_course_card .card-footer{background:transparent;border-top:1px solid #F0EFF7;padding:12px 18px;}.o_wslides_course_card .o_wslides_background_image{border-radius:0;}.o_wslides_course_card h3{color:var(--facodi-heading)!important;font-size:1.08rem;}
.facodi-open-section{background:#F0EEFF!important;border:0!important;border-radius:var(--facodi-radius-lg);margin-bottom:48px;margin-top:16px;padding:clamp(32px,5vw,64px)!important;}.facodi-stat-card,.facodi-community-card,.facodi-roadmap-card,.facodi-resource-grid article{background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important;}
.facodi-footer{background:#171633!important;border:0!important;margin-top:72px;}.facodi-footer-inner{max-width:var(--facodi-container);padding:48px 32px;}.facodi-footer p,.facodi-footer a{color:#D8D7E8!important;}.facodi-footer a:hover{color:#8EDBFF!important;}
.o_wslides_body .o_record_cover_container[data-res-model="slide.channel"]{background-color:#292060!important;background-image:linear-gradient(135deg,#3C2E93,#5B52C9 56%,#5DC7FF)!important;}.o_wslides_course_header,.o_wslides_lesson_header{padding-bottom:30px!important;}.o_record_cover_container .o_wslides_course_header h1,.o_record_cover_container .o_wslides_lesson_header h1{color:#FFF!important;}.o_wslides_course_main .container,.o_wslides_lesson_main{max-width:var(--facodi-container);}
.o_wslides_course_nav,.o_wslides_lesson_nav,.breadcrumb{background:#FFF!important;border:1px solid var(--facodi-line)!important;border-radius:var(--facodi-radius-sm)!important;box-shadow:none!important;}.o_wslides_nav_tabs .nav-link,.o_wslides_lesson_nav .nav-link{border-radius:8px!important;color:var(--facodi-muted);}.o_wslides_nav_tabs .nav-link.active,.o_wslides_lesson_nav .nav-link.active{background:#EEEAFE!important;color:var(--facodi-primary)!important;}.o_wslides_slides_list_slide,.o_wslides_slide_list_category_header,.o_wslides_lesson_card{background:#FFF!important;border:1px solid var(--facodi-line)!important;border-radius:var(--facodi-radius-sm)!important;box-shadow:none!important;margin-bottom:8px;}.o_wslides_slides_list_slide:hover{border-color:rgba(106,75,255,.5)!important;}.badge{border-radius:999px;font-weight:650;}
a:focus-visible,button:focus-visible,input:focus-visible,.btn:focus-visible{outline:3px solid rgba(93,199,255,.75)!important;outline-offset:2px;}
@media(max-width:1024px){.facodi-dashboard{grid-template-columns:1fr!important;padding:12px 24px 52px;}.facodi-side-nav{display:none;}}
@media(max-width:768px){.facodi-nav-shell{padding:0 16px!important;}.facodi-hero{grid-template-columns:1fr!important;min-height:auto;padding:42px 20px!important;}.facodi-hero h1{max-width:11ch;}.facodi-hero-board{max-width:none;}.facodi-course-grid{grid-template-columns:1fr;}.facodi-open-section{border-radius:var(--facodi-radius-md);margin-left:16px;margin-right:16px;}.facodi-footer-inner{grid-template-columns:1fr;padding:42px 20px;}}
@media(max-width:390px){.facodi-actions{display:grid;}.facodi-actions .btn{justify-content:center;width:100%;}.facodi-dashboard{padding-left:16px;padding-right:16px;}}
@media(prefers-color-scheme:dark){body,.facodi-app-shell,.o_wslides_body{background:#0D0D20!important;color:#F0F0FB;}p,.text-muted,small{color:#BBBBD2!important;}h1,h2,h3,h4,h5,h6{color:#F7F7FF!important;}.facodi-header{background:rgba(13,13,32,.86)!important;}.facodi-wordmark,.facodi-header .nav-link{color:#F0F0FB!important;}.facodi-header .nav-link:hover{background:rgba(106,75,255,.25);}.facodi-course-card,.o_wslides_course_card,.o_wslides_slides_list_slide,.o_wslides_slide_list_category_header,.o_wslides_lesson_card,.o_wslides_course_nav,.o_wslides_lesson_nav,.breadcrumb{background:#1A1A31!important;border-color:#343452!important;color:#F0F0FB!important;}.facodi-open-section{background:#211E48!important;}.o_wslides_course_card .card-footer{border-color:#343452;}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:1ms!important;}}
            ]]></style>
        </xpath>
    </template>
</odoo>