<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FACODI course page styling -->

    <template id="facodi_course_main" inherit_id="website_slides.course_main" name="FACODI course main">
        <xpath expr="//div[@id='o_wslides_course_main']" position="attributes">
            <attribute name="class" add="facodi-app-shell" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_course_main_left_column" inherit_id="website_slides.course_main_left_column" name="FACODI course left column">
        <xpath expr="//div[@id='o_wslides_course_main_left_column']" position="attributes">
            <attribute name="class">col-lg-8 col-12 facodi-course-main</attribute>
        </xpath>
    </template>

    <template id="facodi_course_sidebar" inherit_id="website_slides.course_sidebar" name="FACODI course sidebar">
        <xpath expr="//div[@id='o_wslides_course_sidebar']" position="attributes">
            <attribute name="class" add="facodi-course-sidebar" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_course_header" inherit_id="website_slides.course_header" name="FACODI course header">
        <xpath expr="//div[hasclass('o_wslides_course_header')]" position="attributes">
            <attribute name="class" add="facodi-course-header" separator=" "/>
        </xpath>
    </template>
</odoo>
