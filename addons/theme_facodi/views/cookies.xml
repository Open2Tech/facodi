<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FACODI cookie / GDPR banner styling -->

    <template id="facodi_cookies_bar" inherit_id="website.cookies_bar" name="FACODI cookies bar">
        <xpath expr="//div[hasclass('o_cookies_discrete')]" position="attributes">
            <attribute name="class" add="facodi-cookie-bar" separator=" "/>
        </xpath>
        <xpath expr="//a[@id='cookies-consent-all']" position="attributes">
            <attribute name="class" add="btn-primary" separator=" "/>
        </xpath>
        <xpath expr="//a[@id='cookies-consent-essential']" position="attributes">
            <attribute name="class" add="btn-secondary" separator=" "/>
        </xpath>
    </template>
</odoo>
