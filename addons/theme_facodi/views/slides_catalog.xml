<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FACODI course catalog styling -->

    <template id="facodi_courses_home" inherit_id="website_slides.courses_home" name="FACODI courses home">
        <xpath expr="//div[@id='o_wslides_home_wrapper']" position="attributes">
            <attribute name="class" add="facodi-app-shell" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_wslides_discuss_banner')]/div" position="attributes">
            <attribute name="class">alert d-flex align-items-center rounded-3 border-2</attribute>
            <attribute name="style">border-color: var(--facodi-ink); box-shadow: 3px 3px 0 var(--facodi-ink);</attribute>
        </xpath>
    </template>

    <template id="facodi_courses_all" inherit_id="website_slides.courses_all" name="FACODI courses all">
        <xpath expr="//div[hasclass('o_wslides_home_main') and contains(@class, 'col')]" position="attributes">
            <attribute name="class" add="facodi-course-catalog" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('input-group')][.//input[contains(@placeholder, 'Search')]]" position="attributes">
            <attribute name="class" add="facodi-search-input" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('input-group')][.//input[contains(@placeholder, 'Search')]]//input" position="attributes">
            <attribute name="class">form-control border-2 facodi-form-control</attribute>
        </xpath>
    </template>

    <template id="facodi_course_card" inherit_id="website_slides.course_card" name="FACODI course card">
        <xpath expr="//div[hasclass('card')][hasclass('o_wslides_course_card')]" position="attributes">
            <attribute name="class">card o_wslides_course_card facodi-course-card h-100</attribute>
        </xpath>
    </template>
</odoo>
