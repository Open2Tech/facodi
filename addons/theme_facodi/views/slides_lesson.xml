<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FACODI lesson / video page styling -->

    <template id="facodi_slide_main" inherit_id="website_slides.slide_main" name="FACODI slide main">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class">wrap o_wslides_wrap facodi-app-shell</attribute>
        </xpath>
    </template>

    <template id="facodi_slide_content_detailed" inherit_id="website_slides.slide_content_detailed" name="FACODI slide content detailed">
        <xpath expr="//div[hasclass('o_wslides_slide_content')]" position="attributes">
            <attribute name="class" add="facodi-lesson-content" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_aside_training" inherit_id="website_slides.slide_aside_training" name="FACODI slide aside training">
        <xpath expr="//div[hasclass('o_wslides_slide_aside')]" position="attributes">
            <attribute name="class" add="facodi-lesson-sidebar" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_fullscreen" inherit_id="website_slides.slide_fullscreen" name="FACODI slide fullscreen">
        <xpath expr="//div[@id='o_wslides_fs_main']" position="attributes">
            <attribute name="class" add="facodi-fullscreen" separator=" "/>
        </xpath>
    </template>
</odoo>
