<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FACODI lesson / video page styling -->

    <template id="facodi_slide_main" inherit_id="website_slides.slide_main" name="FACODI slide main">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class">wrap o_wslides_wrap facodi-app-shell</attribute>
        </xpath>
    </template>

    <template id="facodi_slide_content_detailed" inherit_id="website_slides.slide_content_detailed" name="FACODI slide content detailed">
        <xpath expr="//div[hasclass('o_wslides_slide_content')]" position="attributes">
            <attribute name="class" add="facodi-lesson-content" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_aside_training" inherit_id="website_slides.slide_aside_training" name="FACODI slide aside training">
        <xpath expr="//div[hasclass('o_wslides_slide_aside')]" position="attributes">
            <attribute name="class" add="facodi-lesson-sidebar" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_fullscreen" inherit_id="website_slides.slide_fullscreen" name="FACODI slide fullscreen">
        <xpath expr="//div[@id='o_wslides_fs_main']" position="attributes">
            <attribute name="class" add="facodi-fullscreen" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_aside_documentation" inherit_id="website_slides.slide_aside_documentation" name="FACODI slide aside documentation">
        <xpath expr="//div[hasclass('o_wslides_slide_aside')]" position="attributes">
            <attribute name="class" add="facodi-lesson-sidebar" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_aside_training_category" inherit_id="website_slides.slide_aside_training_category" name="FACODI slide aside training category">
        <xpath expr="//div[hasclass('o_wslides_slide_aside')]" position="attributes">
            <attribute name="class" add="facodi-lesson-sidebar" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_lesson_content_quiz" inherit_id="website_slides.lesson_content_quiz" name="FACODI lesson quiz container">
        <xpath expr="//div[hasclass('o_wslides_js_lesson_quiz')]" position="attributes">
            <attribute name="class" add="facodi-quiz" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_lesson_content_quiz_question" inherit_id="website_slides.lesson_content_quiz_question" name="FACODI lesson quiz question">
        <xpath expr="//div[hasclass('o_wslides_quiz_question') and hasclass('mb-2')]" position="attributes">
            <attribute name="class" add="facodi-quiz-question" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_comments_tab" inherit_id="website_slides.slide_content_detailed" name="FACODI slide comments tab">
        <xpath expr="//div[@id='discuss']" position="attributes">
            <attribute name="class" add="facodi-lesson-comment" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_slide_share_modal" inherit_id="website_slides.slide_share_modal" name="FACODI slide share modal">
        <xpath expr="//div[hasclass('modal-content')]" position="attributes">
            <attribute name="class" add="facodi-modal" separator=" "/>
        </xpath>
    </template>
</odoo>
