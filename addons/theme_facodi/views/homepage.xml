<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The FACODI homepage is a website.page record whose arch inherits
        website.homepage.  Using noupdate="1" preserves any in-place edits
        made by the site admin after the theme is applied.
    -->
    <template id="facodi_homepage" inherit_id="website.homepage"
              name="FACODI learning dashboard" priority="20">
        <xpath expr="//div[@id='wrap']" position="replace">
            <!-- oe_empty required for Odoo 19 COW view rendering; facodi-app-shell applied via body CSS -->
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Inject courses; fallback to empty list if mixin is inactive -->
                <t t-set="facodi_channels" t-value="request.env['slide.channel'].sudo().search([('website_published','=',True)], order='sequence, id', limit=6)"/>
                <section class="facodi-hero" data-name="FACODI Welcome">
                    <div class="facodi-hero-copy">
                        <p class="facodi-kicker"><i class="fa fa-circle" aria-hidden="true"/> Aprenda em comunidade</p>
                        <h1>Seu próximo capítulo começa em rede.</h1>
                        <p class="facodi-lead">Currículos oficiais, recursos abertos e uma comunidade que transforma conhecimento em possibilidade.</p>
                        <div class="facodi-actions">
                            <a class="btn facodi-button facodi-button-primary" href="/slides">Explorar cursos <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a>
                            <a class="btn facodi-button facodi-button-secondary" href="/web/login">Continuar aprendendo</a>
                        </div>
                    </div>
                    <div class="facodi-hero-board" aria-label="Mapa de aprendizagem">
                        <div class="facodi-board-top"><span>Mapa de aprendizagem</span><span class="facodi-live-dot">Aberto</span></div>
                        <div class="facodi-board-path">
                            <div class="facodi-path-node is-complete"><i class="fa fa-compass" aria-hidden="true"/></div>
                            <div class="facodi-path-line is-complete"/>
                            <div class="facodi-path-node is-current">02</div>
                            <div class="facodi-path-line"/>
                            <div class="facodi-path-node">03</div>
                        </div>
                        <div class="facodi-board-cards">
                            <div><span>Descubra</span><strong>Encontre um curso</strong></div>
                            <div class="is-selected"><span>Aprenda</span><strong>No seu ritmo</strong></div>
                            <div><span>Contribua</span><strong>Em comunidade</strong></div>
                        </div>
                    </div>
                </section>

                <section class="facodi-dashboard" data-name="FACODI Dashboard">
                    <aside class="facodi-side-nav" aria-label="Learning navigation">
                        <p>MINHA JORNADA</p>
                        <a class="is-active" href="/sobre"><i class="fa fa-th-large" aria-hidden="true"/>Visão geral</a>
                        <a href="/slides"><i class="fa fa-book" aria-hidden="true"/>Cursos</a>
                        <a href="/website/search"><i class="fa fa-compass" aria-hidden="true"/>Descobrir</a>
                        <a href="/web/login"><i class="fa fa-bookmark-o" aria-hidden="true"/>Salvos</a>
                        <a href="/comunidade"><i class="fa fa-users" aria-hidden="true"/>Comunidade</a>
                    </aside>
                    <div class="facodi-dashboard-main">
                        <div class="facodi-section-heading">
                            <div><p class="facodi-kicker">Catálogo de aprendizagem</p><h2>Cursos publicados</h2></div>
                            <a href="/slides" class="facodi-text-link">Ver todos os cursos <i class="fa fa-arrow-right" aria-hidden="true"/></a>
                        </div>
                        <!-- Real published channels are injected by the website.page mixin. -->
                        <div class="facodi-course-grid">
                            <t t-if="facodi_channels">
                                <t t-foreach="facodi_channels" t-as="channel">
                                    <a t-attf-href="/slides/#{slug(channel)}"
                                       class="facodi-course-card"
                                       t-att-aria-label="channel.name">
                                        <div class="facodi-course-art">
                                            <t t-if="channel.image_1920">
                                                <div t-field="channel.image_1920"
                                                     t-options="{'widget':'image','preview_image':'image_128'}"
                                                     class="facodi-course-art-img"/>
                                            </t>
                                            <t t-else="">
                                                <span t-out="(channel.name or '')[:2].upper()"/>
                                                <i class="fa fa-book" aria-hidden="true"/>
                                            </t>
                                        </div>
                                        <div class="facodi-course-content">
                                            <p t-field="channel.description_short"/>
                                            <h3 t-field="channel.name"/>
                                            <t t-if="channel.completion">
                                                <div class="facodi-progress">
                                                    <span t-attf-style="width:#{channel.completion}%"/>
                                                </div>
                                            </t>
                                            <div class="facodi-card-bottom">
                                                <t t-if="channel.completion">
                                                    <span><t t-out="channel.completion"/>% concluído</span>
                                                </t>
                                                <t t-else="">
                                                    <span><t t-out="channel.total_slides"/> aulas</span>
                                                </t>
                                                <i class="fa fa-arrow-right" aria-hidden="true"/>
                                            </div>
                                        </div>
                                    </a>
                                </t>
                            </t>
                            <t t-else="">
                                <article class="facodi-course-card facodi-course-cyan">
                                    <div class="facodi-course-art"><span>+</span><i class="fa fa-book" aria-hidden="true"/></div>
                                    <div class="facodi-course-content"><p>Catálogo</p><h3>Nenhum curso publicado ainda</h3><div class="facodi-card-bottom"><a href="/slides" aria-label="Abrir catálogo"><i class="fa fa-arrow-right" aria-hidden="true"/></a></div></div>
                                </article>
                            </t>
                        </div>
                    </div>
                    <aside class="facodi-insights" aria-label="Learning insights">
                        <article class="facodi-roadmap-card">
                            <div class="facodi-panel-label"><span>PRÓXIMO ESTUDO</span></div>
                            <h3>Explore os cursos disponíveis</h3>
                            <p>Acesse o catálogo de cursos e encontre o próximo tópico para sua jornada de aprendizagem.</p>
                            <a class="btn facodi-button facodi-button-secondary" href="/slides">Ver catálogo <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a>
                        </article>
                    </aside>
                </section>

                <section class="facodi-open-section" data-name="FACODI Open Learning">
                    <div><p class="facodi-kicker">Conhecimento que circula</p><h2>Uma faculdade aberta para quem quer construir o futuro.</h2></div>
                    <div class="facodi-open-actions"><p>Estude com roteiros claros. Contribua com recursos revisados. Transforme seu percurso em algo que outras pessoas também podem seguir.</p><a class="btn facodi-button facodi-button-secondary" href="/sobre">Conhecer a FACODI <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a></div>
                </section>

                <!-- Features -->
                <section class="container py-5" data-name="FACODI Features">
                    <div class="facodi-section-heading">
                        <div><p class="facodi-kicker"><i class="fa fa-circle" aria-hidden="true"/> Funcionalidades</p><h2>Como o FACODI apoia a sua aprendizagem.</h2></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-3 col-sm-6">
                            <article class="facodi-stat-card h-100">
                                <span>01 — Percursos</span>
                                <strong>Currículos</strong>
                                <small>Trilhas organizadas por áreas de conhecimento com objetivos de aprendizagem claros.</small>
                                <i class="fa fa-compass" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <article class="facodi-stat-card h-100">
                                <span>02 — Recursos</span>
                                <strong>Playlists</strong>
                                <small>Vídeos, artigos e materiais curados e revisados pela comunidade FACODI.</small>
                                <i class="fa fa-play-circle" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <article class="facodi-stat-card h-100">
                                <span>03 — Acompanhar</span>
                                <strong>Progresso</strong>
                                <small>Registo dos cursos inscritos, conteúdos assistidos e percurso completo.</small>
                                <i class="fa fa-check-circle" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <article class="facodi-stat-card h-100">
                                <span>04 — Participar</span>
                                <strong>Curadoria</strong>
                                <small>A comunidade propõe, revê e valida os recursos publicados na plataforma.</small>
                                <i class="fa fa-users" aria-hidden="true"/>
                            </article>
                        </div>
                    </div>
                </section>

                <!-- Journey steps -->
                <section class="container py-5" data-name="FACODI Journey">
                    <div class="facodi-section-heading">
                        <div><p class="facodi-kicker"><i class="fa fa-circle" aria-hidden="true"/> Como funciona</p><h2>Três passos para começar a aprender.</h2></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-4">
                            <article class="facodi-stat-card h-100">
                                <span>Passo 01</span>
                                <strong>Descubra</strong>
                                <small>Explore o catálogo e encontre um curso ou trilha que se alinhe com os seus objetivos.</small>
                                <i class="fa fa-search" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-4">
                            <article class="facodi-stat-card h-100" style="background:var(--facodi-blue);color:white;border-color:var(--facodi-ink);">
                                <span>Passo 02</span>
                                <strong>Aprenda</strong>
                                <small>Siga o percurso ao seu ritmo, com vídeos e materiais curados para cada etapa.</small>
                                <i class="fa fa-book" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-4">
                            <article class="facodi-stat-card h-100">
                                <span>Passo 03</span>
                                <strong>Contribua</strong>
                                <small>Partilhe recursos, sugira melhorias e ajude outros estudantes a crescer.</small>
                                <i class="fa fa-comments" aria-hidden="true"/>
                            </article>
                        </div>
                    </div>
                </section>

                <!-- Manifesto callout -->
                <section class="facodi-open-section" data-name="FACODI Manifesto Callout">
                    <div>
                        <p class="facodi-kicker"><i class="fa fa-flag" aria-hidden="true"/> Manifesto</p>
                        <h2>Aprender em público e construir com outras pessoas.</h2>
                    </div>
                    <div class="facodi-open-actions">
                        <p>O FACODI entende a educação aberta como infraestrutura comunitária: organizada, acessível, verificável e orientada a quem precisa de percursos reais para continuar a aprender.</p>
                        <a class="btn facodi-button facodi-button-secondary" href="/manifesto">Ler manifesto <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a>
                    </div>
                </section>

                <!-- Institutional recognition -->
                <section class="container py-5" data-name="FACODI Institutional">
                    <div class="row g-3 align-items-stretch">
                        <div class="col-lg-4 col-sm-6">
                            <article class="facodi-stat-card h-100">
                                <span>Aliança</span>
                                <strong>SEA-EU</strong>
                                <small>Projeto selecionado nos SEA-EU Student-Led Projects 2026 para educação digital aberta.</small>
                                <i class="fa fa-globe" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-4 col-sm-6">
                            <article class="facodi-stat-card h-100">
                                <span>Universidade</span>
                                <strong>UAlg</strong>
                                <small>Associado à Universidade do Algarve no âmbito da chamada SEA-EU Student-Led Projects.</small>
                                <i class="fa fa-university" aria-hidden="true"/>
                            </article>
                        </div>
                        <div class="col-lg-4">
                            <article class="facodi-community-card facodi-stat-card h-100">
                                <div class="facodi-panel-label"><span>Projeto</span></div>
                                <h3>Conhecer a FACODI.</h3>
                                <p>Saiba mais sobre a missão, o enquadramento institucional e as prioridades do projeto.</p>
                                <a class="btn facodi-button facodi-button-secondary" href="/sobre">Sobre a FACODI <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a>
                            </article>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>