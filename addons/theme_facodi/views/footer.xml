<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="facodi_footer" inherit_id="website.layout" name="FACODI footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="facodi-footer" data-name="FACODI Footer" t-ignore="true" t-if="not no_footer">
                <div class="container-fluid facodi-footer-inner">
                    <div>
                        <a href="/" class="facodi-wordmark">FACODI<span>.</span></a>
                        <p>Faculdade Comunitária Digital. Educação superior aberta, colaborativa e acessível.</p>
                    </div>
                    <div class="facodi-footer-links">
                        <div class="facodi-footer-group">
                            <strong>Aprender</strong>
                            <a href="/slides">Cursos</a>
                            <a href="/website/search">Descobrir</a>
                            <a href="/web/login">Minha conta</a>
                        </div>
                        <div class="facodi-footer-group">
                            <strong>Conhecer</strong>
                            <a href="/sobre">Sobre a FACODI</a>
                            <a href="/manifesto">Manifesto</a>
                            <a href="/roadmap">Roadmap</a>
                        </div>
                        <div class="facodi-footer-group">
                            <strong>Participar</strong>
                            <a href="/comunidade">Comunidade</a>
                            <a href="/como-contribuir">Como contribuir</a>
                            <a href="/contactus">Contato</a>
                        </div>
                    </div>
                    <p class="facodi-footer-meta">Open source para aprender em público.<br/><span t-esc="datetime.datetime.now().year"/> FACODI<br/>Criado por <a href="https://open2.tech" target="_blank" rel="noopener noreferrer">Open2 Technology</a></p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>