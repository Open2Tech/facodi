<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="runtime_refinement_patch" inherit_id="website.layout" name="FACODI runtime refinement patch" priority="999">
        <xpath expr="//head" position="inside">
            <style type="text/css"><![CDATA[
.o_wslides_course_card>div:first-child .badge.bg-secondary{left:14px!important;top:14px!important;z-index:2;}
.facodi-course-cover-meta{align-items:flex-end;bottom:16px;top:auto;}
.o_wslides_course_card .card-footer{gap:10px;}
.o_wslides_course_card p{display:block!important;margin:0;overflow:visible!important;}
.o_wslides_course_card .card-text .o_line_clamp{display:block!important;max-height:none!important;overflow:visible!important;-webkit-line-clamp:unset!important;}
footer#bottom{display:none!important;}
#wrap .facodi-stat-card{background:var(--facodi-surface)!important;border:1px solid var(--facodi-line)!important;border-radius:var(--facodi-radius-md)!important;box-shadow:0 8px 20px rgba(31,30,66,.07)!important;display:flex;flex-direction:column;gap:10px;min-height:184px;padding:24px!important;}
#wrap .facodi-stat-card>span,#wrap .facodi-stat-card>.facodi-panel-label{color:var(--facodi-primary);font-size:.76rem;font-weight:750;letter-spacing:.05em;line-height:1.3;text-transform:uppercase;}
#wrap .facodi-stat-card>strong,#wrap .facodi-stat-card>h3{color:var(--facodi-heading)!important;font-size:1.45rem;font-weight:750;line-height:1.15;margin:0;}
#wrap .facodi-stat-card>p,#wrap .facodi-stat-card>small,#wrap .facodi-stat-card>ul{color:var(--facodi-muted)!important;font-size:.95rem;line-height:1.5;margin:0;}
#wrap .facodi-stat-card>ul{padding-left:1.2rem;}
#wrap .facodi-stat-card>.fa{align-self:flex-end;color:var(--facodi-primary);margin-top:auto;position:static;}
#wrap .facodi-community-card{background:#EEF0FF!important;}
.o_wslides_slides_list{counter-reset:facodi-lesson;position:relative;}
.o_wslides_slides_list::before{background:linear-gradient(180deg,rgba(106,75,255,.34),rgba(93,199,255,.18));border-radius:999px;content:"";left:18px;position:absolute;top:18px;bottom:24px;width:2px;}
.o_wslides_slides_list .o_wslides_js_list_item{counter-increment:facodi-lesson;margin-left:0!important;padding-left:54px!important;position:relative;}
.o_wslides_slides_list .o_wslides_js_list_item::before{align-items:center;background:linear-gradient(135deg,#6A4BFF,#5DC7FF);border:3px solid #FFF;border-radius:999px;box-shadow:0 8px 18px rgba(64,50,143,.18);color:#FFF;content:counter(facodi-lesson);display:inline-flex;font-size:.78rem;font-weight:700;height:28px;justify-content:center;left:4px;position:absolute;top:calc(50% - 14px);width:28px;}
.o_wslides_slides_list .o_wslides_js_list_item>.fa{color:var(--facodi-primary);margin-right:8px!important;position:relative;z-index:1;}
@media(max-width:390px){.facodi-course-cover-meta{bottom:12px;}}
@media(prefers-color-scheme:dark){.o_wslides_slides_list .o_wslides_js_list_item::before{border-color:#1A1A31;}}
            ]]></style>
        </xpath>
    </template>
</odoo>