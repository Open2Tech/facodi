<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FACODI error and empty states -->

    <template id="facodi_http_error_4xx" inherit_id="http_routing.4xx" name="FACODI HTTP 4xx error page">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="facodi-app-shell" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('container')][h1[contains(text(), 'Oops')]]" position="attributes">
            <attribute name="class">container facodi-empty-state text-start align-items-start</attribute>
        </xpath>
    </template>

    <template id="facodi_http_error_403" inherit_id="http_routing.403" name="FACODI HTTP 403 error page">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="facodi-app-shell" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('container')][h1[contains(text(), 'Forbidden')]]" position="attributes">
            <attribute name="class">container facodi-empty-state text-start align-items-start</attribute>
        </xpath>
    </template>

    <template id="facodi_http_error_404" inherit_id="http_routing.404" name="FACODI HTTP 404 error page">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="facodi-app-shell" separator=" "/>
        </xpath>
    </template>
</odoo>
