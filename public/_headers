# FACODI — Cloudflare Workers Static Assets
# Applied to files served by Workers assets; does not modify Supabase responses.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Workers preview stays accessible for QA but must not compete with the canonical site.
https://facodi.marcelo-0d6.workers.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Private and authentication routes must remain unindexed even for crawlers that do not run the SPA.
/login*
  X-Robots-Tag: noindex, nofollow, noarchive
/auth*
  X-Robots-Tag: noindex, nofollow, noarchive
/dashboard*
  X-Robots-Tag: noindex, nofollow, noarchive
/profile*
  X-Robots-Tag: noindex, nofollow, noarchive
/editor*
  X-Robots-Tag: noindex, nofollow, noarchive
/admin*
  X-Robots-Tag: noindex, nofollow, noarchive
/notes*
  X-Robots-Tag: noindex, nofollow, noarchive
/suggest*
  X-Robots-Tag: noindex, nofollow, noarchive
/playlists*
  X-Robots-Tag: noindex, nofollow, noarchive
/community/join*
  X-Robots-Tag: noindex, nofollow, noarchive

# The public build revision must reflect the currently deployed assets.
/build-revision.txt
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Vite fingerprints JS/CSS assets. They can be cached until their names change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
